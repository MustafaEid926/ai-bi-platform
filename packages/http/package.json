{
    "name":  "@aibi/http",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/server.js",
                    "test":  "node --test"
                },
    "dependencies":  {
                         "@aibi/errors":  "workspace:*",
                         "express":  "^5.1.0"
                     },
    "devDependencies":  {
                            "@types/express":  "^5.0.3",
                            "@types/node":  "^24.3.0",
                            "tsx":  "^4.19.0",
                            "typescript":  "^5.9.2"
                        },
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                }
}
